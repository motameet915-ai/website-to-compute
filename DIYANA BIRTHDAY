<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Happy Birthday, Diyana ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:#fff6fb;
    --pink:#ff4da6;
    --deep:#d81b60;
    --muted:#6b6b6b;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0;font-family:"Poppins",system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial}
  body{
    background: radial-gradient(1200px 800px at 10% 10%, #fff0f6, transparent),
                radial-gradient(900px 600px at 90% 90%, #fff6f9, transparent),
                var(--bg);
    color:#222;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    overflow-x:hidden;
  }

  /* Page layout */
  .app{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:28px;
    position:relative;
  }
  .card{
    width:100%;
    max-width:920px;
    background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,250,254,0.95));
    border-radius:20px;
    box-shadow: 0 20px 50px rgba(200,60,120,0.12);
    padding:34px;
    position:relative;
    overflow:hidden;
  }

  header{
    display:flex;
    gap:18px;
    align-items:center;
    justify-content:space-between;
    margin-bottom:18px;
  }
  .title{
    display:flex;
    gap:14px;
    align-items:center;
  }
  .logo{
    width:64px;height:64px;border-radius:12px;
    background:linear-gradient(135deg,var(--pink),#ffd7ec);
    display:flex;align-items:center;justify-content:center;font-weight:700;color:white;
    font-size:22px;box-shadow:0 8px 18px rgba(255,77,166,0.18);
    transform:rotate(-7deg);
  }
  h1{font-size:1.6rem;margin:0;color:var(--deep)}
  p.lead{margin:0;color:var(--muted)}

  /* Play button */
  .controls{display:flex;gap:12px;align-items:center}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    padding:10px 14px;border-radius:10px;border:0;cursor:pointer;
    background:var(--pink);color:white;font-weight:600;box-shadow:0 8px 22px rgba(255,77,166,0.16);
  }
  .btn.ghost{background:transparent;color:var(--deep);box-shadow:none;border:1px solid rgba(216,27,96,0.08)}

  /* content area */
  .page{
    padding:10px 6px 34px;
    min-height:420px;
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    gap:18px;
  }
  .page.active{display:flex}

  .center{
    text-align:center;
    max-width:820px;
  }

  /* Start card */
  .start-cta{
    margin-top:18px;
  }

  /* Quiz */
  .quiz-box{
    width:100%;
    display:flex;
    gap:20px;
    align-items:flex-start;
    justify-content:space-between;
    flex-wrap:wrap;
  }
  .q-left{flex:1 1 320px;min-width:260px}
  .q-right{flex:0 0 260px;max-width:320px}

  .question{
    background:linear-gradient(180deg,#fff,#fff0f8);
    border-radius:14px;padding:20px;border:1px solid rgba(216,27,96,0.06);
    box-shadow:0 12px 30px rgba(216,27,96,0.04);
    font-weight:600;font-size:1.1rem;color:var(--deep);
    display:flex;align-items:center;gap:14px;
  }

  .answers{
    margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px;
  }
  .answer{
    padding:12px;border-radius:10px;background:white;border:1px solid rgba(0,0,0,0.06);
    cursor:pointer;display:flex;align-items:center;gap:12px;font-weight:600;
    transition:transform .15s ease,box-shadow .15s;
  }
  .answer:hover{transform:translateY(-6px);box-shadow:0 18px 30px rgba(0,0,0,0.06)}
  .answer.selected{background:linear-gradient(90deg,#ffd7ec,#ffeff7);border-color:rgba(255,77,166,0.28)}

  .progress{
    margin-top:14px;font-size:.95rem;color:var(--muted);
  }

  .navs{display:flex;gap:12px;margin-top:12px;align-items:center}
  .pager{font-weight:700;color:var(--deep)}

  /* Result */
  .result-card{
    border-radius:14px;padding:28px;background:linear-gradient(180deg,#fff, #fff7fb);
    box-shadow:0 18px 40px rgba(216,27,96,0.07);text-align:center;
  }
  .final-msg{font-size:1.05rem;line-height:1.6;color:#333;margin:14px 0}
  .nick{font-weight:800;color:var(--pink)}

  /* floating hearts & sparkles */
  .hearts{position:absolute;inset:0;pointer-events:none;overflow:hidden}
  .heart{
    position:absolute;width:14px;height:14px;border-radius:4px;transform:rotate(-30deg);
    background:linear-gradient(180deg,#ff8fbf,#ff4da6);opacity:.95;filter:drop-shadow(0 8px 16px rgba(255,77,166,.12));
    animation:floatUp 8s linear infinite;
  }
  @keyframes floatUp{
    0%{transform:translateY(20vh) scale(.6) rotate(-20deg);opacity:0}
    10%{opacity:1}
    100%{transform:translateY(-120vh) scale(1.4) rotate(50deg);opacity:0}
  }

  /* small sparkles overlay */
  .sparkles{
    position:absolute;inset:0;pointer-events:none;background-image:
    radial-gradient(circle at 10% 20%, rgba(255,255,255,0.9) 1px, transparent 1px),
    radial-gradient(circle at 80% 80%, rgba(255,255,255,0.85) 1px, transparent 1px);
    background-size: 60px 60px, 80px 80px;
    opacity:.6;mix-blend-mode:screen;filter:blur(.2px);
    animation:moveSpark 6s linear infinite;
  }
  @keyframes moveSpark{from{background-position:0 0,0 0}to{background-position:200px 80px, -120px -200px}}

  /* confetti (result) */
  .confetti{
    position:absolute;inset:0;pointer-events:none;
  }
  .confetti-piece{
    position:absolute;width:10px;height:16px;opacity:0;transform-origin:center;
    background:linear-gradient(90deg,#ffd7ec,#ffeff7);
    animation:confettiDrop linear forwards;
  }

  @keyframes confettiDrop{
    0%{opacity:0;transform:translateY(-10vh) rotate(0) scale(.6)}
    10%{opacity:1}
    100%{opacity:1;transform:translateY(110vh) rotate(540deg) scale(1)}
  }

  /* small responsive */
  @media (max-width:720px){
    .quiz-box{flex-direction:column}
    .q-right{max-width:none;flex-basis:auto}
  }

  footer{margin-top:8px;text-align:center;color:var(--muted);font-size:.9rem}
</style>
</head>
<body>

<div class="app">
  <div class="card" role="main" aria-labelledby="mainTitle">

    <header>
      <div class="title">
        <div class="logo">D💗</div>
        <div>
          <h1 id="mainTitle">Happy Birthday, Diyana!</h1>
          <p class="lead">A little quiz & love letter made for you — with sparkles ✨</p>
        </div>
      </div>

      <div class="controls" aria-hidden="false">
        <button id="muteBtn" class="btn ghost" title="Play / Pause music">Play Music ♪</button>
        <button id="startBtn" class="btn">Start Quiz 🎁</button>
      </div>
    </header>

    <!-- pages -->
    <section id="home" class="page active" aria-label="Landing page">
      <div class="center">
        <h2 style="margin:0 0 8px">A small surprise</h2>
        <p style="margin:0;color:var(--muted)">
          I made this little quiz to celebrate you — a playful way to say how much you mean to me.
          Answer the questions and reach the end for a special message. 💌
        </p>

        <div class="start-cta">
          <button class="btn" id="beginBtn">Begin the Quiz ✨</button>
        </div>
      </div>
    </section>

    <section id="quiz" class="page" aria-label="Quiz page">
      <div class="quiz-box">

        <div class="q-left">
          <div class="question" id="questionText">Question will appear here</div>

          <div class="answers" id="answers"></div>

          <div class="navs">
            <div class="progress" id="progress">Question 1 / 12</div>
            <div style="flex:1"></div>
            <div><button id="prev" class="btn ghost">Prev</button></div>
            <div><button id="next" class="btn">Next</button></div>
          </div>
        </div>

        <aside class="q-right">
          <div style="padding:18px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff6fb);border:1px solid rgba(216,27,96,0.04)">
            <h3 style="margin:0 0 6px">Hints</h3>
            <p style="margin:0;color:var(--muted)">All answers are true — it's a celebration of you. Pick what feels right and enjoy the little animations along the way ✨</p>
            <div style="margin-top:12px">
              <div style="font-weight:700;color:var(--deep)">Score-ish: <span id="scoreBadge">—</span></div>
            </div>
          </div>

          <div style="margin-top:12px;padding:16px;border-radius:12px;background:linear-gradient(180deg,#fff,#fff7fb);border:1px solid rgba(0,0,0,0.04)">
            <h4 style="margin:0 0 8px">Your choices</h4>
            <div id="choicesList" style="color:var(--muted)">No answers yet</div>
          </div>
        </aside>

      </div>
    </section>

    <section id="result" class="page" aria-label="Result page">
      <div class="result-card">
        <div style="font-size:2.2rem">🎉</div>
        <h2 style="margin:.2rem 0 .6rem">You did it, Diyana!</h2>

        <p class="final-msg" id="finalMessage">
          <!-- Final message injected by script -->
        </p>

        <div style="margin-top:12px">
          <button id="restart" class="btn">Restart Quiz</button>
          <button id="share" class="btn ghost">Save / Screenshot</button>
        </div>
      </div>
    </section>

    <footer aria-hidden="true">Made with lots of love 💗 — from your <span class="nick">cuto-puto</span></footer>

    <!-- decorative layers -->
    <div class="hearts" id="hearts"></div>
    <div class="sparkles" aria-hidden="true"></div>
    <div class="confetti" id="confetti"></div>

  </div>
</div>

<!-- audio (place a music.mp3 file next to the HTML OR update src) -->
<audio id="bgm" loop preload="auto">
  <source src="music.mp3" type="audio/mpeg">
  <!-- Browser may block autoplay; user can press Play -->
</audio>

<script>
/* --------- Content: polished message for Diyana --------- */
const polishedMessage = `Diyana, I didn't fall in love with you because I wanted a relationship. I fell for you because, for the first time, someone made me feel truly important. You treat me with such love and warmth that you feel like home to me. You are caring, gentle, and endlessly sweet — my cuto-puto, my smooosi, my potato, my baccha. I love you more than words can hold. 💗`;

/* --------- Questions (12) --------- */
const QUESTIONS = [
  {q:"Who makes me smile the fastest?", opts:["You, always","A funny video","A snack","My pet"]},
  {q:"Who treats me like I truly matter?", opts:["You do","My family","My best friend","Myself sometimes"]},
  {q:"Who feels like home to me?", opts:["You","A cozy corner","A city","A playlist"]},
  {q:"Who is my softest, cutest human?", opts:["You (no contest)","A puppy","Clouds","My pillow"]},
  {q:"Who do I trust with my silly secrets?", opts:["You","My diary","My sibling","Nobody"]},
  {q:"Who cheers me up on rough days?", opts:["You with your care","A walk","Music","Chocolate"]},
  {q:"Who is my cuto-puto?", opts:["You","A cartoon","A cactus","My mug"]},
  {q:"Who is my smooosi?", opts:["You","A marshmallow","My hoodie","Sunset"]},
  {q:"Who is my potato?", opts:["You","A baked potato","My cozy socks","My phone"]},
  {q:"Who is my baccha (adorable kid) in my heart?", opts:["You","A baby animal","A plush toy","A memory"]},
  {q:"Who makes the little things feel special?", opts:["You","A small note","A song","A sunset"]},
  {q:"Who do I want to spend more birthdays with?", opts:["You, forever","My family","My friends","Myself growing"]},
];

/* --------- App state --------- */
let state = {
  page: 'home',
  index: 0,
  answers: Array(QUESTIONS.length).fill(null)
};

/* --------- DOM refs --------- */
const pages = { home: document.getElementById('home'), quiz: document.getElementById('quiz'), result: document.getElementById('result') };
const startBtn = document.getElementById('startBtn');
const beginBtn = document.getElementById('beginBtn');
const prevBtn = document.getElementById('prev');
const nextBtn = document.getElementById('next');
const restartBtn = document.getElementById('restart');
const questionText = document.getElementById('questionText');
const answersEl = document.getElementById('answers');
const progress = document.getElementById('progress');
const choicesList = document.getElementById('choicesList');
const scoreBadge = document.getElementById('scoreBadge');
const finalMessageEl = document.getElementById('finalMessage');
const muteBtn = document.getElementById('muteBtn');
const bgm = document.getElementById('bgm');
const hearts = document.getElementById('hearts');
const confetti = document.getElementById('confetti');
const shareBtn = document.getElementById('share');

/* --------- Navigation helpers --------- */
function showPage(name){
  state.page = name;
  Object.keys(pages).forEach(k => pages[k].classList.toggle('active', k===name));
  if(name==='quiz') renderQuestion();
  if(name==='result') showResult();
}

/* --------- Quiz rendering --------- */
function renderQuestion(){
  const i = state.index;
  const item = QUESTIONS[i];
  questionText.textContent = `${i+1}. ${item.q}`;
  progress.textContent = `Question ${i+1} / ${QUESTIONS.length}`;

  // render answers
  answersEl.innerHTML = '';
  item.opts.forEach((opt, idx) => {
    const btn = document.createElement('button');
    btn.className = 'answer';
    btn.type = 'button';
    btn.innerHTML = `<span>${opt}</span>`;
    if(state.answers[i] === idx) btn.classList.add('selected');
    btn.onclick = () => {
      state.answers[i] = idx;
      updateChoicesUI();
      // animate selection
      btn.classList.add('selected');
      setTimeout(()=> btn.classList.remove('selected'), 600);
      // small score-ish calc
      scoreBadge.textContent = `${state.answers.filter(a=>a!==null).length}/${QUESTIONS.length}`;
    };
    answersEl.appendChild(btn);
  });

  // prev/next enabled
  prevBtn.disabled = i===0;
  nextBtn.textContent = i===QUESTIONS.length-1 ? 'Finish 🎉' : 'Next';
  updateChoicesUI();
}

/* --------- choices list UI --------- */
function updateChoicesUI(){
  const chosen = state.answers.map((a, idx) => a===null ? `Q${idx+1}: —` : `Q${idx+1}: ${QUESTIONS[idx].opts[a]}`);
  choicesList.innerHTML = chosen.join('<br>');
  scoreBadge.textContent = `${state.answers.filter(a=>a!==null).length}/${QUESTIONS.length}`;
}

/* --------- navigation actions --------- */
prevBtn.addEventListener('click', ()=>{
  if(state.index>0){ state.index--; renderQuestion(); }
});
nextBtn.addEventListener('click', ()=>{
  // if last and any unanswered, allow advance (it's fine) — it's a love quiz, not a test.
  if(state.index < QUESTIONS.length-1){
    state.index++;
    renderQuestion();
    // small sparkle when moving pages
    spawnHeartsOnce(6);
  } else {
    showPage('result');
    confettiBurst();
  }
});
startBtn.addEventListener('click', ()=> showPage('quiz'));
beginBtn.addEventListener('click', ()=> showPage('quiz'));
restartBtn.addEventListener('click', ()=> {
  state.index = 0; state.answers = Array(QUESTIONS.length).fill(null);
  updateChoicesUI(); showPage('home'); clearConfetti();
});

/* --------- Result page --------- */
function showResult(){
  // Compose a small personalized result using the answers (lightly)
  const answered = state.answers.map((a,i) => a===null ? null : QUESTIONS[i].opts[a]);
  const sample = answered.filter(Boolean).slice(0,4);
  let mini = '';
  if(sample.length){
    mini = `You chose: ${sample.join(' · ')}. `;
  }
  finalMessageEl.innerHTML = `<strong>${mini}</strong><br>${polishedMessage}`;
  // make hearts float gently
  spawnHeartsOnce(18);
}

/* --------- Hearts & confetti visuals --------- */
function spawnHeartsOnce(n=10){
  for(let i=0;i<n;i++){
    const el = document.createElement('div');
    el.className = 'heart';
    const left = Math.random()*100;
    el.style.left = left+'%';
    el.style.top = 70 + Math.random()*20 + 'vh';
    el.style.width = (10+Math.random()*22)+'px';
    el.style.height = (10+Math.random()*22)+'px';
    el.style.opacity = (0.7+Math.random()*0.4);
    el.style.animationDuration = (6+Math.random()*6)+'s';
    el.style.animationDelay = (Math.random()*1)+'s';
    hearts.appendChild(el);
    // remove after animation
    setTimeout(()=> el.remove(), 10000);
  }
}

function confettiBurst(){
  const colors = ['#ffd7ec','#fff0f6','#ffb6d8','#fff1f7'];
  for(let i=0;i<40;i++){
    const c = document.createElement('div');
    c.className = 'confetti-piece';
    const left = Math.random()*100;
    c.style.left = left+'%';
    c.style.background = colors[Math.floor(Math.random()*colors.length)];
    c.style.top = (-10 - Math.random()*6)+'vh';
    c.style.width = (6+Math.random()*10)+'px';
    c.style.height = (10+Math.random()*18)+'px';
    c.style.animationDuration = (3 + Math.random()*3)+'s';
    c.style.animationDelay = (Math.random()*0.6)+'s';
    confetti.appendChild(c);
    setTimeout(()=> c.remove(), 7000);
  }
}
function clearConfetti(){ confetti.innerHTML=''; }

/* --------- Audio controls --------- */
let playing = false;
function toggleMusic(){
  if(bgm.paused){
    bgm.play().then(()=> {
      playing = true; muteBtn.textContent = 'Pause Music ⏸';
      muteBtn.classList.remove('ghost'); muteBtn.classList.add('btn');
    }).catch(()=> {
      // Autoplay blocked — show hint
      muteBtn.textContent = 'Play Music ♪';
      alert('Your browser blocked autoplay. Press Play (Music) again to start the song.');
    });
  } else {
    bgm.pause(); playing=false;
    muteBtn.textContent = 'Play Music ♪';
    muteBtn.classList.remove('btn'); muteBtn.classList.add('ghost');
  }
}
muteBtn.addEventListener('click', toggleMusic);

/* --------- small utilities --------- */
shareBtn.addEventListener('click', ()=> {
  // simple screenshot hint (can't take screenshot from webpage reliably without user)
  alert('To save this, take a screenshot or press Ctrl/Cmd+S to save the page as HTML. ❤️');
});

/* --------- initial setup --------- */
updateChoicesUI();
scoreBadge.textContent = `0/${QUESTIONS.length}`;

/* Small friendly tips: try to auto-play once on user gesture (start button) */
startBtn.addEventListener('click', ()=> {
  // try to start music softly
  if(bgm.paused){
    bgm.volume = 0.45;
    bgm.play().then(()=> {
      playing = true; muteBtn.textContent='Pause Music ⏸'; muteBtn.classList.remove('ghost'); muteBtn.classList.add('btn');
    }).catch(()=> {/* ignore */});
  }
});

/* Accessibility: allow keyboard next/prev */
document.addEventListener('keydown', (e)=>{
  if(state.page==='quiz'){
    if(e.key==='ArrowRight') nextBtn.click();
    if(e.key==='ArrowLeft') prevBtn.click();
  }
});

/* Make hearts occasionally float in background for landing */
setInterval(()=> spawnHeartsOnce(3), 4200);
</script>

</body>
</html>
